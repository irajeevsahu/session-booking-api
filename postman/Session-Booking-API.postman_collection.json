    {
      "name": "3. Available Sessions",
      "item": [
        {
          "name": "Get Available Sessions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions",
                "available"
              ],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}"
                }
              ]
            },
            "description": "dateTimestamp = Unix timestamp in milliseconds; any time within the day (UTC) works."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is JSON with success=true', () => {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "const data = pm.response.json().data;",
                  "const ids = data.sessions.map((s) => s._id);",
                  "pm.test('Contains the created session', () => pm.expect(ids).to.include(pm.collectionVariables.get('sessionId')));",
                  "pm.test('Only AVAILABLE sessions', () => data.sessions.forEach((s) => pm.expect(s.status).to.eql('AVAILABLE')));",
                  "pm.test('Teacher details are joined', () => pm.expect(data.sessions[0].teacher).to.have.property('fullName'));"
                ]
              }
            }
          ]
        },
