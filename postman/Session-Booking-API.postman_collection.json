    {
      "name": "2. Create Session",
      "item": [
        {
          "name": "Create Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"teacherId\": \"{{teacherId}}\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Session slots are always \"tomorrow\" (UTC) so the collection can be re-run any day.",
                  "const now = new Date();",
                  "const day = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1);",
                  "const iso = (h) => new Date(day + h * 3600 * 1000).toISOString();",
                  "pm.collectionVariables.set('startTime', iso(10));",
                  "pm.collectionVariables.set('endTime', iso(11));",
                  "pm.collectionVariables.set('secondStartTime', iso(13));",
                  "pm.collectionVariables.set('secondEndTime', iso(14));",
                  "pm.collectionVariables.set('overlapStartTime', iso(10.5));",
                  "pm.collectionVariables.set('overlapEndTime', iso(11.5));",
                  "// Any timestamp inside the day works; midday is used here.",
                  "pm.collectionVariables.set('dateTimestamp', String(day + 12 * 3600 * 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response is JSON with success=true', () => {",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});",
                  "const data = pm.response.json().data;",
                  "pm.test('Default status is AVAILABLE', () => pm.expect(data.status).to.eql('AVAILABLE'));",
                  "pm.test('userId and completedAt are null', () => {",
                  "  pm.expect(data.userId).to.eql(null);",
                  "  pm.expect(data.completedAt).to.eql(null);",
                  "});",
                  "pm.collectionVariables.set('sessionId', data._id);"
                ]
              }
            }
          ]
        },
