{
  "name": "session-booking-api",
  "version": "1.0.0",
  "description": "REST API for booking sessions with teachers (Node.js, TypeScript, Express, MongoDB, Mongoose)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.10",
    "morgan": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
